{#
    Viden tab — placeholder for the knowledge-recipe write-up.

    Backed by a future `knowledgeRecipe` field. The design note on
    data-sharing constraints stays visible so operators understand
    that datasets are never shared between municipalities.
#}
<div class="grid gap-4">
    <h2 class="text-lg font-semibold text-ink">
        {{ 'assistant.detail.viden.heading'|trans }}
    </h2>
    <p class="text-sm text-text-muted">
        {{ 'assistant.detail.viden.lead'|trans }}
    </p>
    <div class="rounded-xl border border-dashed border-line bg-surface-2 p-6 text-sm text-text-muted italic"
         role="note">
        {{ 'assistant.detail.placeholder_body'|trans }}
    </div>
</div>
