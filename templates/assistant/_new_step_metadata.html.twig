{#
    Step 2 body — metadata fields the user reviews and edits.
    Every input is pre-filled from the DTO the flow's step-1
    listener populated from the detected source format.
#}
<div class="grid gap-4">
    {% if draft.framework|framework_experimental %}
        <div class="rounded-lg border border-line bg-surface-2 px-4 py-3 text-sm text-text" role="note">
            {{ 'assistant.new.step_metadata.experimental_notice'|trans({'%format%': draft.framework|framework_label}) }}
        </div>
    {% endif %}
    {{ form_row(flow.metadata.title) }}
    {{ form_row(flow.metadata.description) }}
    {{ form_row(flow.metadata.languageModel) }}
    {# Known models offered as suggestions; the curator may still type a custom value. #}
    <datalist id="{{ flow.metadata.languageModel.vars.model_datalist_id }}">
        {% for label, id in flow.metadata.languageModel.vars.model_choices %}
            <option value="{{ id }}">{{ label }}</option>
        {% endfor %}
    </datalist>
    {{ form_row(flow.metadata.tags) }}
</div>
