{#
    Step 2 body — metadata fields the user reviews and edits.
    Every input is pre-filled from the DTO the flow's step-1
    listener populated via OpenWebUiMetadataExtractor.

    The `languageModel` field renders as a plain `<input>` that
    a Choices.js-backed Stimulus controller enhances into a
    tag-input combobox: suggestions from SUPPORTED_LANGUAGE_MODELS
    ∪ previously-persisted values, plus free-tagging on the
    typed value via the "+ Tilføj" affordance. Turning JS off
    leaves a plain text input behind.
#}
{% set lm = flow.metadata.languageModel %}
{% set lm_options = lm.vars.language_model_options %}
<div class="grid gap-4">
    {{ form_row(flow.metadata.title) }}
    {{ form_row(flow.metadata.description) }}

    <div data-controller="language-model-picker"
         data-language-model-picker-known-options-value="{{ lm_options|json_encode }}"
         data-language-model-picker-add-text-value="{{ 'assistant.new.step_metadata.language_model_add_hint'|trans({'%value%': '%s'}) }}"
         data-language-model-picker-search-placeholder-value="{{ 'assistant.new.step_metadata.language_model_search_placeholder'|trans }}"
         data-language-model-picker-no-results-text-value="{{ 'assistant.new.step_metadata.language_model_no_results'|trans }}"
         data-language-model-picker-no-choices-text-value="{{ 'assistant.new.step_metadata.language_model_no_choices'|trans }}"
         data-language-model-picker-item-select-text-value="{{ 'assistant.new.step_metadata.language_model_item_select'|trans }}">
        {{ form_row(lm) }}
    </div>

    {{ form_row(flow.metadata.framework) }}
    {{ form_row(flow.metadata.tags) }}
</div>
