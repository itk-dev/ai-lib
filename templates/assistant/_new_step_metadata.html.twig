{#
    Step 2 body — metadata fields the user reviews and edits.
    Every input is pre-filled from the DTO the flow's step-1
    listener populated via OpenWebUiMetadataExtractor.

    The `languageModel` field renders as a `<select>` seeded
    with SUPPORTED_LANGUAGE_MODELS ∪ previously-persisted
    values. A Choices.js-backed Stimulus controller turns it
    into a search-as-you-type combobox. Turning JS off leaves a
    plain `<select>` behind.

    Server-side is a plain `TextType` so any submitted
    `<option>` value (including a pre-emitted current value
    that isn't on the shortlist) round-trips through the form
    as a string.
#}
{% set lm = flow.metadata.languageModel %}
{% set lm_options = lm.vars.language_model_options %}
{% set lm_value = lm.vars.value %}
{% set lm_full_name = lm.vars.full_name %}
{% set lm_id = lm.vars.id %}
{% set lm_row_class = 'grid gap-1 text-sm' %}
{% set lm_label_class = 'block font-medium text-ink' %}
{% set lm_input_class = 'rounded-lg border border-line bg-surface px-3 py-2 text-base text-ink focus:outline-none focus:ring-2 focus:ring-primary/40' %}
<div class="grid gap-4">
    {{ form_row(flow.metadata.title) }}
    {{ form_row(flow.metadata.description) }}

    <div class="{{ lm_row_class }}"
         data-controller="language-model-picker"
         data-language-model-picker-placeholder-value="{{ 'assistant.new.step_metadata.language_model_search_placeholder'|trans }}">
        <label for="{{ lm_id }}" class="{{ lm_label_class }}">
            {{ 'assistant.new.step_metadata.language_model_label'|trans }}
        </label>
        <select id="{{ lm_id }}" name="{{ lm_full_name }}" class="{{ lm_input_class }}">
            {#
                Pre-emit the current value as a selected `<option>`
                even when it isn't on the shortlist — otherwise a
                value the extractor pulled out of the JSON that
                isn't in the picker's known set would be silently
                dropped by the browser's `<select>` validation.
            #}
            {% if lm_value is not empty and lm_value not in lm_options %}
                <option value="{{ lm_value }}" selected>{{ lm_value }}</option>
            {% endif %}
            {% for option in lm_options %}
                <option value="{{ option }}"{% if option == lm_value %} selected{% endif %}>
                    {{ option }}
                </option>
            {% endfor %}
        </select>
        {% if lm.vars.help is defined and lm.vars.help %}
            <p class="text-sm text-text-muted">{{ lm.vars.help|trans }}</p>
        {% endif %}
        {{ form_errors(lm) }}
        {#
            Mark the field as rendered so `form_end(flow)`'s
            trailing `form_rest` doesn't re-emit it as a plain
            `<input>` alongside the `<select>`.
        #}
        {% do lm.setRendered %}
    </div>

    {{ form_row(flow.metadata.framework) }}
    {{ form_row(flow.metadata.tags) }}
</div>
