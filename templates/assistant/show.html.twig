{% extends 'base.html.twig' %}

{% block title %}{{ 'assistant.detail.title'|trans({'%title%': assistant.title, '%brand%': brand_name}) }}{% endblock %}

{% block body %}
    <twig:Layout:ContentWithAsides>
        <twig:block name="main">
            <article class="grid gap-8">
                <header>
                    <p class="mb-4">
                        <a class="text-sm font-medium text-text-muted no-underline hover:text-primary"
                           href="{{ path('app_frontpage') }}">
                            {{ 'assistant.detail.back'|trans }}
                        </a>
                    </p>
                    <twig:Eyebrow as="p" class="mb-4">{{ 'assistant.detail.eyebrow'|trans }}</twig:Eyebrow>
                    <twig:Heading level="1" class="mb-4">{{ assistant.title }}</twig:Heading>
                    <p class="max-w-[60ch] text-lg leading-relaxed text-text">
                        {{ assistant.description }}
                    </p>
                </header>
            </article>
        </twig:block>

        <twig:block name="meta">
            <twig:Box eyebrow="assistant.detail.runtime_heading">
                <twig:DescriptionList:List>
                    <twig:DescriptionList:Item label="assistant.detail.framework_label">
                        {{ assistant.framework }}
                    </twig:DescriptionList:Item>
                    <twig:DescriptionList:Item label="assistant.detail.language_model_label">
                        {{ assistant.languageModel }}
                    </twig:DescriptionList:Item>
                </twig:DescriptionList:List>
                <a class="mt-4 inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white no-underline hover:bg-primary/90"
                   href="{{ path('app_assistant_export', {id: assistant.id}) }}"
                   download>
                    {{ 'assistant.detail.export'|trans }}
                </a>
            </twig:Box>
        </twig:block>

        <twig:block name="actions">
            {% if assistant.tags is not empty %}
                <twig:Box eyebrow="assistant.detail.tags_heading">
                    <ul class="flex flex-wrap gap-2" aria-label="{{ 'assistant.detail.tags_heading'|trans }}">
                        {% for tag in assistant.tags %}
                            <li class="inline-flex items-center rounded-full border border-line bg-surface-2 px-3 py-1 text-sm text-text">
                                {{ tag.name }}
                            </li>
                        {% endfor %}
                    </ul>
                </twig:Box>
            {% endif %}
        </twig:block>
    </twig:Layout:ContentWithAsides>
{% endblock %}
