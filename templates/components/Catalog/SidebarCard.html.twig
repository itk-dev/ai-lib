{#
    A titled box for the catalogue's right-hand sidebar.

    Shares the bordered-surface look of the filter rail and sort box, with an
    eyebrow-style heading and a content slot. Used for the "Aktive filtre",
    "Seneste søgninger" and "Klar til hjemtagning" boxes.

    props:
      - title: translation key for the box heading
#}
{% props title %}
<aside aria-label="{{ title|trans }}"
       class="flex flex-col gap-3 rounded-xl border border-line bg-surface p-5">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-ink">{{ title|trans }}</h2>
    {% block content %}{% endblock %}
</aside>
