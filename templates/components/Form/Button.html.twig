{% props
    type = 'submit',
    variant = 'primary',
    shape = 'rounded',
    size = 'md',
    href = null,
%}
{# `variant`, `shape`, and `size` map to Tailwind utility groups so future #}
{# variants (secondary, danger, etc.), shapes, and sizes can be added in #}
{# one place. When `href` is set the component renders an anchor with the #}
{# same shape so links can carry the button affordance without nesting an #}
{# <a> inside a <button> (which is invalid HTML and breaks activation). #}
{% set variants = {
    primary: 'bg-primary text-primary-ink hover:bg-primary-hover',
} %}
{% set shapes = {
    rounded: 'rounded-lg',
    pill: 'rounded-full',
} %}
{% set sizes = {
    sm: 'px-3 py-1.5 text-sm font-medium',
    md: 'px-4 py-2 font-semibold',
} %}
{% set baseClass = 'inline-flex items-center transition-colors ' ~ shapes[shape] ~ ' ' ~ sizes[size] ~ ' ' ~ variants[variant] %}
{% set slot %}{% block content %}{% endblock %}{% endset %}
{% if href is not null %}
<a href="{{ href }}" class="no-underline {{ baseClass }}">{{ slot }}</a>
{% else %}
<button type="{{ type }}" class="{{ baseClass }}">{{ slot }}</button>
{% endif %}
