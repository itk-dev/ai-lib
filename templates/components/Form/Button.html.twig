{% props
    type = 'submit',
    variant = 'primary',
    shape = 'rounded',
    size = 'md',
    class = '',
%}
{# `variant`, `shape`, and `size` map to Tailwind utility groups so future #}
{# variants (secondary, danger, etc.), shapes, and sizes can be added in #}
{# one place. `class` appends extras (margins, layout hooks); #}
{# `{{ attributes }}` lets call sites pass through `data-*` and `aria-*` #}
{# attributes (e.g. Stimulus targets/actions on a menu trigger button). #}
{% set variants = {
    primary: 'bg-primary text-primary-ink hover:bg-primary-hover',
    ghost: 'text-ink hover:bg-surface-2',
} %}
{% set shapes = {
    rounded: 'rounded-lg',
    pill: 'rounded-full',
} %}
{% set sizes = {
    sm: 'px-3 py-1.5 text-sm font-medium',
    md: 'px-4 py-2 font-semibold',
} %}
<button type="{{ type }}"
        class="inline-flex items-center transition-colors {{ shapes[shape] }} {{ sizes[size] }} {{ variants[variant] }}{{ class ? ' ' ~ class : '' }}"
        {{ attributes }}>
    {% block content %}{% endblock %}
</button>
