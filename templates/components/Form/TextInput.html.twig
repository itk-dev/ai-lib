{% props
    id,
    name,
    type = 'text',
    value = '',
    placeholder = null,
    autocomplete = null,
    required = false,
    autofocus = false,
%}
{# `{{ attributes }}` spreads arbitrary call-site attributes and merges any #}
{# extra `class` onto the default appearance, so call sites can size the #}
{# field (e.g. `w-full flex-1`) without restyling it. #}
<input id="{{ id }}"
       name="{{ name }}"
       type="{{ type }}"
       value="{{ value }}"
       {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
       {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
       {% if required %}required{% endif %}
       {% if autofocus %}autofocus{% endif %}
       {{ attributes.defaults({class: 'rounded-lg border border-line bg-surface px-3 py-2 text-base text-ink focus:outline-none focus:ring-2 focus:ring-primary/40'}) }}>
