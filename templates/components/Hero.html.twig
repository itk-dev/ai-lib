{% props eyebrow %}
<section class="max-w-3xl">
    <twig:Eyebrow as="p" class="mb-4">{{ eyebrow|trans }}</twig:Eyebrow>
    <twig:Heading level="1" class="mb-4">{% block heading %}{% endblock %}</twig:Heading>
    <p class="max-w-[60ch] text-lg leading-relaxed text-text">
        {% block lead %}{% endblock %}
    </p>
    {% block content %}{% endblock %}
</section>
