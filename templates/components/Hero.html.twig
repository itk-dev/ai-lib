{% props eyebrow %}
{# Capture the caller-filled `heading`/`lead` blocks into variables first, #}
{# then pass them as the slot content. Referencing a nested {% block %} #}
{# directly inside the <twig:Heading> slot does not forward the caller's #}
{# fill into the component, so the heading rendered empty. #}
{% set headingContent %}{% block heading %}{% endblock %}{% endset %}
{% set leadContent %}{% block lead %}{% endblock %}{% endset %}
<section class="max-w-3xl">
    <twig:Eyebrow as="p" class="mb-4">{{ eyebrow|trans }}</twig:Eyebrow>
    <twig:Heading level="1" class="mb-4">{{ headingContent|raw }}</twig:Heading>
    <p class="max-w-[60ch] text-lg leading-relaxed text-text">
        {{ leadContent|raw }}
    </p>
    {% block content %}{% endblock %}
</section>
