{% props
    level = 1,
    size = null,
    weight = null,
    class = '',
%}
{# Renders <h1>..<h6> from `level`, with a size token chosen by `size` #}
{# (or auto-derived from `level` when omitted). `weight` overrides the #}
{# size's default font-weight ('normal', 'medium', 'semibold', 'bold') — #}
{# e.g. 'normal' for a lighter box heading. `class` appends extras like #}
{# `mb-4` or layout hooks without leaking design tokens to callers. #}
{% set sizeClasses = {
    xl: 'font-display text-[clamp(2rem,3vw,2.6rem)] leading-tight tracking-tight text-ink',
    lg: 'font-display text-[clamp(1.75rem,3vw,2.25rem)] leading-tight tracking-tight text-ink',
    md: 'font-display text-2xl tracking-tight text-ink',
    sm: 'font-display text-xl text-ink',
} %}
{% set defaultWeights = {xl: 'medium', lg: 'medium', md: 'medium', sm: 'semibold'} %}
{% set weightClasses = {
    normal: 'font-normal',
    medium: 'font-medium',
    semibold: 'font-semibold',
    bold: 'font-bold',
} %}
{% set resolvedSize = size ?? (level == 1 ? 'xl' : (level == 2 ? 'md' : 'sm')) %}
{% set resolvedWeight = weightClasses[weight ?? defaultWeights[resolvedSize]] %}
{% set tag = 'h' ~ level %}
<{{ tag }} class="{{ sizeClasses[resolvedSize] }} {{ resolvedWeight }}{{ class ? ' ' ~ class : '' }}">
    {%- block content -%}{%- endblock -%}
</{{ tag }}>
