{% props
    level = 1,
    size = null,
    class = '',
%}
{# Renders <h1>..<h6> from `level`, with a size token chosen by `size` #}
{# (or auto-derived from `level` when omitted). `class` appends extras #}
{# like `mb-4` or layout hooks without leaking design tokens to callers. #}
{% set sizeClasses = {
    xl: 'font-display text-[clamp(2rem,3vw,2.6rem)] font-medium leading-tight tracking-tight text-ink',
    lg: 'font-display text-[clamp(1.75rem,3vw,2.25rem)] font-medium leading-tight tracking-tight text-ink',
    md: 'font-display text-2xl font-medium tracking-tight text-ink',
    sm: 'font-display text-xl font-semibold text-ink',
} %}
{% set resolvedSize = size ?? (level == 1 ? 'xl' : (level == 2 ? 'md' : 'sm')) %}
{% set tag = 'h' ~ level %}
<{{ tag }} class="{{ sizeClasses[resolvedSize] }}{{ class ? ' ' ~ class : '' }}">
    {%- block content -%}{%- endblock -%}
</{{ tag }}>
