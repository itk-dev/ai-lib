{% props class = '' %}
{#
    Single-column page layout — the default shape.

    Wraps the page body in a centered, narrow container
    (`max-w-narrow`, ≈ 1180px) inside the wider `<main>` element
    (which shares its width with the header and footer at
    ≈ 1600px). Use for routes whose body is a single line of
    content: frontpage, login, registration, simple admin forms,
    error pages.

    The `view-root` class hooks into the global fade-up animation
    in `assets/styles/app.css`, so direct children fade up in
    sequence.

    Slot:
    - `content` — the page body.
#}
<div class="mx-auto w-full max-w-narrow view-root grid grid-cols-1 gap-12{{ class ? ' ' ~ class : '' }}">
    {% block content %}{% endblock %}
</div>
