{#
    Preview modal for a single email-template body field.

    Rendered inside a `<div data-controller="email-preview">`
    wrapper that also hosts the subject input and body textarea
    (targets `subjectInput` / `bodyInput` on the Stimulus
    controller). The preview link triggers a POST to the JSON
    endpoint, the response payload is dropped into an
    `<iframe sandbox="allow-same-origin">` via `srcdoc` so the
    admin-typed HTML runs isolated from the admin origin.

    Nested `<form>` inside another `<form>` is invalid HTML, so
    the dialog uses a plain `<div>` layout instead of the usual
    `<form method="dialog">` pattern, and the hidden CSRF token
    lives in a `<div hidden>` carrier — the shared
    `generateCsrfToken()` helper only queries for the input
    inside it and doesn't care whether the surrounding element
    is a `<form>` or not.

    Include vars:
    - `id`     — DOM-id suffix used for the dialog + labelledby id
    - `label`  — translation key for the Preview link text
#}

<div class="mt-2 flex flex-wrap items-center gap-3">
    <button type="button"
            data-action="click->email-preview#open"
            class="text-sm font-medium text-primary underline hover:text-primary-hover">
        {{ label|trans }}
    </button>
</div>

<dialog data-email-preview-target="dialog"
        aria-labelledby="{{ id }}Title"
        class="max-w-3xl w-full rounded-xl border border-line bg-surface p-0 shadow-xl backdrop:bg-ink/40">
    <div class="grid gap-4 p-6">
        <header class="flex items-start justify-between gap-4">
            <div class="grid gap-1">
                <h2 id="{{ id }}Title" class="text-lg font-semibold text-ink">
                    {{ 'admin.settings.email.preview.modal_title'|trans }}
                </h2>
                <p class="text-sm text-text-muted">
                    <span class="font-medium">{{ 'admin.settings.email.preview.subject_prefix'|trans }}</span>
                    <span data-email-preview-target="subjectDisplay" class="ml-1"></span>
                </p>
            </div>
            <button type="button"
                    data-action="click->email-preview#close"
                    aria-label="{{ 'admin.settings.email.preview.close'|trans }}"
                    class="rounded-full border border-line px-3 py-1 text-sm text-text hover:bg-surface-2">
                ×
            </button>
        </header>
        <p data-email-preview-target="error"
           role="alert"
           class="hidden rounded-lg border border-line bg-surface-2 px-3 py-2 text-sm text-red-700">
            {{ 'admin.settings.email.preview.error'|trans }}
        </p>
        <iframe data-email-preview-target="iframe"
                sandbox="allow-same-origin"
                referrerpolicy="no-referrer"
                class="h-96 w-full rounded-lg border border-line bg-white"
                title="{{ 'admin.settings.email.preview.modal_title'|trans }}"></iframe>
    </div>
</dialog>

<div data-email-preview-target="csrfForm" hidden aria-hidden="true">
    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('admin-settings-email-preview') }}">
</div>
