{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.users.title'|trans({'%brand%': brand_name}) }}{% endblock %}

{% block body %}
    <section class="max-w-4xl">
        <twig:Eyebrow as="p" class="mb-4">{{ 'admin.users.eyebrow'|trans }}</twig:Eyebrow>
        <twig:Heading level="1" size="lg" class="mb-6">{{ 'admin.users.heading'|trans }}</twig:Heading>

        {% for flash in app.flashes('success') %}
            <twig:Alert type="success" class="mb-4">
                {{ flash|trans }}
            </twig:Alert>
        {% endfor %}

        {% if is_granted('ROLE_ADMIN') %}
            <p class="mb-6">
                <twig:Form:Button href="{{ path('app_admin_user_new') }}">
                    {{ 'admin.users.action.new'|trans }}
                </twig:Form:Button>
            </p>
        {% endif %}

        <nav aria-label="{{ 'admin.users.filter_label'|trans }}" class="mb-6 flex flex-wrap gap-3 text-sm">
            <a class="rounded-full border border-line px-3 py-1 {% if status_filter is null %}bg-surface-2 text-ink{% else %}text-text hover:bg-surface-2{% endif %}"
               href="{{ path('app_admin_users') }}">
                {{ 'admin.users.filter.all'|trans }}
            </a>
            <a class="rounded-full border border-line px-3 py-1 {% if status_filter and status_filter.value == 'pending' %}bg-surface-2 text-ink{% else %}text-text hover:bg-surface-2{% endif %}"
               href="{{ path('app_admin_users', {status: 'pending'}) }}">
                {{ 'admin.users.filter.pending'|trans }}
            </a>
            <a class="rounded-full border border-line px-3 py-1 {% if status_filter and status_filter.value == 'approved' %}bg-surface-2 text-ink{% else %}text-text hover:bg-surface-2{% endif %}"
               href="{{ path('app_admin_users', {status: 'approved'}) }}">
                {{ 'admin.users.filter.approved'|trans }}
            </a>
            <a class="rounded-full border border-line px-3 py-1 {% if status_filter and status_filter.value == 'blocked' %}bg-surface-2 text-ink{% else %}text-text hover:bg-surface-2{% endif %}"
               href="{{ path('app_admin_users', {status: 'blocked'}) }}">
                {{ 'admin.users.filter.blocked'|trans }}
            </a>
        </nav>

        {% if users is empty %}
            <p class="text-sm text-text">{{ 'admin.users.empty'|trans }}</p>
        {% else %}
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>{{ 'admin.users.columns.name'|trans }}</twig:Table:HeadCell>
                        <twig:Table:HeadCell>{{ 'admin.users.columns.email'|trans }}</twig:Table:HeadCell>
                        <twig:Table:HeadCell>{{ 'admin.users.columns.status'|trans }}</twig:Table:HeadCell>
                        <twig:Table:HeadCell align="right">{{ 'admin.users.columns.actions'|trans }}</twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for u in users %}
                        {% set back_url = path('app_admin_users', status_filter ? {status: status_filter.value} : {}) %}
                        <twig:Table:Row>
                            <twig:Table:Cell>
                                <span class="font-medium text-ink">{{ u.name }}</span>
                            </twig:Table:Cell>
                            <twig:Table:Cell>{{ u.email }}</twig:Table:Cell>
                            <twig:Table:Cell>
                                <span class="rounded-full border border-line px-2 py-0.5 text-xs text-text">
                                    {{ ('admin.users.status.' ~ u.status.value)|trans }}
                                </span>
                            </twig:Table:Cell>
                            <twig:Table:Cell align="right">
                                <div class="inline-flex flex-wrap items-center gap-2">
                                    {% if u.status.value != 'approved' %}
                                        <form action="{{ path('app_admin_user_approve', {id: u.id}) }}" method="post" class="inline">
                                            <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('admin-user-action') }}">
                                            <input type="hidden" name="back" value="{{ back_url }}">
                                            <twig:Form:Button type="submit" size="sm">
                                                {{ 'admin.users.action.approve'|trans }}
                                            </twig:Form:Button>
                                        </form>
                                    {% endif %}

                                    {% if u.status.value != 'blocked' %}
                                        <form action="{{ path('app_admin_user_block', {id: u.id}) }}" method="post" class="inline">
                                            <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('admin-user-action') }}">
                                            <input type="hidden" name="back" value="{{ back_url }}">
                                            <twig:Form:Button type="submit" size="sm">
                                                {{ 'admin.users.action.block'|trans }}
                                            </twig:Form:Button>
                                        </form>
                                    {% endif %}
                                </div>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        {% endif %}
    </section>
{% endblock %}
