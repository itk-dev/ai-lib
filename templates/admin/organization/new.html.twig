{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.organization.new.title'|trans({'%brand%': brand_name}) }}{% endblock %}

{% block body %}
    <section class="max-w-2xl">
        <twig:Eyebrow as="p" class="mb-4">{{ 'admin.organization.eyebrow'|trans }}</twig:Eyebrow>
        <h1 class="mb-6 font-display text-[clamp(1.75rem,3vw,2.25rem)] font-medium leading-tight tracking-tight text-ink">
            {{ 'admin.organization.new.heading'|trans }}
        </h1>

        {{ include('admin/organization/_form.html.twig', {
            form: form,
            submit_label: 'admin.organization.action.create',
        }) }}
    </section>
{% endblock %}
